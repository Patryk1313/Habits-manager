        "#7968A2",
    },
    cellLevel5: {
      backgroundColor:
        "#8B7CF6",
      borderWidth: 1,
      borderColor:
        "#A497FF",
    },
    perfectDot: {
      width: 5,
      height: 5,
      borderRadius: 3,
      backgroundColor:
        "#FFFFFF",
    },
    // =====================
    // LEGENDA
    // =====================
    legendRow: {
      flexDirection: "row",
      alignItems: "center",
      justifyContent:
        "flex-end",
      marginTop: 9,
      gap: 4,
    },
    legendText: {
      color: "#686872",
      fontSize: 8,
      fontWeight: "600",
      marginHorizontal: 3,
    },
    legendCell: {
      width: 11,
      height: 11,
      borderRadius: 3,
    },
    // =====================
    // SUMMARY
    // =====================
    summary: {
      marginTop: 17,
