      width:
        CELL_SIZE,
      height:
        CELL_SIZE,
      borderRadius: 7,
      marginBottom:
        CELL_GAP,
      alignItems: "center",
      justifyContent:
        "center",
    },
    placeholderCell: {
      width:
        CELL_SIZE,
      height:
        CELL_SIZE,
      marginBottom:
        CELL_GAP,
    },
    // =====================
    // INTENSITY
    // =====================
    cellEmpty: {
      backgroundColor:
        "#202027",
      borderWidth: 1,
      borderColor:
        "#2A2A32",
    },
    cellLevel1: {
