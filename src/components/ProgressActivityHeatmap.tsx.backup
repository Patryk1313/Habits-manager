import {
  ScrollView,
  StyleSheet,
  Text,
  View,
} from "react-native";
import type {
  DailyProgressStats,
} from "../utils/progress-stats";
// =========================
// TYPY
// =========================
type Props = {
  data: DailyProgressStats[];
  title?: string;
  periodLabel?: string;
};
// =========================
// STAŁE
// =========================
const DAYS = [
  "P",
  "W",
  "Ś",
  "C",
  "P",
  "S",
  "N",
];
const CELL_SIZE = 24;
const CELL_GAP = 5;
// =========================
// HELPERY
// =========================
function getIntensity(
  day: DailyProgressStats
) {
  if (
    day.expected === 0 &&
    !day.hasActivity
  ) {
    return 0;
  }
  if (
    day.successRate <= 0
  ) {
    return 1;
  }
  if (
    day.successRate <= 25
  ) {
    return 2;
  }
  if (
    day.successRate <= 50
  ) {
    return 3;
  }
  if (
    day.successRate <= 75
  ) {
    return 4;
  }
  return 5;
}
function getCellStyle(
  intensity: number
) {
  if (
    intensity === 0
  ) {
    return styles.cellEmpty;
  }
  if (
    intensity === 1
  ) {
    return styles.cellLevel1;
  }
  if (
    intensity === 2
  ) {
    return styles.cellLevel2;
  }
  if (
    intensity === 3
  ) {
    return styles.cellLevel3;
  }
  if (
    intensity === 4
  ) {
    return styles.cellLevel4;
  }
  return styles.cellLevel5;
}
// =========================
// KOMPONENT
// =========================
export default function ProgressActivityHeatmap({
  data,
  title = "AKTYWNOŚĆ",
  periodLabel = "12 TYGODNI",
}: Props) {
  // =========================
  // PODZIAŁ NA TYGODNIE
  // =========================
  const weeks: DailyProgressStats[][] =
    [];
  for (
    let index = 0;
    index < data.length;
    index += 7
  ) {
    weeks.push(
      data.slice(
        index,
        index + 7
      )
    );
  }
  // =========================
  // PODSUMOWANIE
  // =========================
  const daysWithPlan =
    data.filter(
      (day) =>
        day.expected > 0
    ).length;
  const perfectDays =
    data.filter(
      (day) =>
        day.expected > 0 &&
        day.successRate ===
          100
    ).length;
  const average =
    daysWithPlan > 0
      ? Math.round(
          data.reduce(
            (
              total,
              day
            ) =>
              total +
              (day.expected > 0
                ? day.successRate
                : 0),
            0
          ) /
            daysWithPlan
        )
      : 0;
  return (
    <View
      style={
        styles.card
      }
    >
      {/* ===================== */}
      {/* HEADER */}
      {/* ===================== */}
      <View
        style={
          styles.header
        }
      >
        <Text
          style={
            styles.title
          }
        >
          {title}
        </Text>
        <View
          style={
            styles.periodBadge
          }
        >
          <Text
            style={
              styles.periodText
            }
          >
            {periodLabel}
          </Text>
        </View>
      </View>
      {/* ===================== */}
      {/* HEATMAP */}
      {/* ===================== */}
      {data.length === 0 ? (
        <View
          style={
            styles.emptyState
          }
        >
          <Text
            style={
              styles.emptyStateText
            }
          >
            Brak danych do
            wyświetlenia.
          </Text>
        </View>
      ) : (
        <>
          <View
            style={
              styles.heatmapRow
            }
          >
            {/* ================= */}
            {/* DNI TYGODNIA */}
            {/* ================= */}
            <View
              style={
                styles.daysColumn
              }
            >
              {DAYS.map(
                (
                  day,
                  index
                ) => (
                  <View
                    key={
                      `${day}-${index}`
                    }
                    style={
                      styles.dayLabelContainer
                    }
                  >
                    <Text
                      style={
                        styles.dayLabel
                      }
                    >
                      {day}
                    </Text>
                  </View>
                )
              )}
            </View>
            {/* ================= */}
            {/* TYGODNIE */}
            {/* ================= */}
            <ScrollView
              horizontal
              showsHorizontalScrollIndicator={
                false
              }
              contentContainerStyle={
                styles.weeksContainer
              }
            >
              {weeks.map(
                (
                  week,
                  weekIndex
                ) => (
                  <View
                    key={
                      `week-${weekIndex}`
                    }
                    style={
                      styles.weekColumn
                    }
                  >
                    {Array.from({
                      length: 7,
                    }).map(
                      (
                        _,
                        dayIndex
                      ) => {
                        const day =
                          week[
                            dayIndex
                          ];
                        if (
                          !day
                        ) {
                          return (
                            <View
                              key={
                                `empty-${dayIndex}`
                              }
                              style={
                                styles.placeholderCell
                              }
                            />
                          );
                        }
                        const intensity =
                          getIntensity(
                            day
                          );
                        return (
                          <View
                            key={
                              day.dateKey
                            }
                            style={[
                              styles.cell,
                              getCellStyle(
                                intensity
                              ),
                            ]}
                          >
                            {day.expected >
                              0 &&
                              day.successRate ===
                                100 && (
                                <View
                                  style={
                                    styles.perfectDot
                                  }
                                />
                              )}
                          </View>
                        );
                      }
                    )}
                  </View>
                )
              )}
            </ScrollView>
          </View>
          {/* =================== */}
          {/* LEGENDA */}
          {/* =================== */}
          <View
            style={
              styles.legendRow
            }
          >
            <Text
              style={
                styles.legendText
              }
            >
              Mniej
            </Text>
            <View
              style={[
                styles.legendCell,
                styles.cellLevel1,
              ]}
            />
            <View
              style={[
                styles.legendCell,
                styles.cellLevel2,
              ]}
            />
            <View
              style={[
                styles.legendCell,
                styles.cellLevel3,
              ]}
            />
            <View
              style={[
                styles.legendCell,
                styles.cellLevel4,
              ]}
            />
            <View
              style={[
                styles.legendCell,
                styles.cellLevel5,
              ]}
            />
            <Text
              style={
                styles.legendText
              }
            >
              Więcej
            </Text>
          </View>
          {/* =================== */}
          {/* PODSUMOWANIE */}
          {/* =================== */}
          <View
            style={
              styles.summary
            }
          >
            <View
              style={
                styles.summaryItem
              }
            >
              <Text
                style={
                  styles.summaryLabel
                }
              >
                ŚREDNIO
              </Text>
              <Text
                style={
                  styles.summaryValue
                }
              >
                {average}%
              </Text>
            </View>
            <View
              style={
                styles.summaryDivider
              }
            />
            <View
              style={
                styles.summaryItem
              }
            >
              <Text
                style={
                  styles.summaryLabel
                }
              >
                PEŁNE DNI
              </Text>
              <Text
                style={
                  styles.summaryValue
                }
              >
                {perfectDays}
              </Text>
            </View>
          </View>
        </>
      )}
    </View>
  );
}
// =========================
// STYLE
// =========================
