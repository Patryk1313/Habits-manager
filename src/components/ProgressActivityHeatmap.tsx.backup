  StyleSheet.create({
    // =====================
    // CARD
    // =====================
    card: {
      backgroundColor:
        "#18181F",
      borderRadius: 24,
      borderWidth: 1,
      borderColor:
        "#292932",
      paddingHorizontal: 16,
      paddingTop: 17,
      paddingBottom: 16,
    },
    // =====================
    // HEADER
    // =====================
    header: {
